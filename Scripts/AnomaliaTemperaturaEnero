import pandas as pd
import matplotlib.pyplot as plt

# ------------------------------------------------------------------
# 1. Cargar los datos
# ------------------------------------------------------------------
# na_values='***' -> la NASA usa "***" para marcar datos faltantes

ruta_datos = r"C:\Users\Emily\OneDrive\Documentos\Haciendo Economía\Taller 5\Raw data\Air&WaterTempAnom.csv"
df = pd.read_csv(ruta_datos, skiprows=1, na_values="***")

# revisamos que Year sea numerico y que el rango de años sea el esperado.
assert df["Year"].is_monotonic_increasing, "Los años no estan ordenados"
print("Rango de años en los datos:", df["Year"].min(), "-", df["Year"].max())

# El ultimo año puede estar incompleto (por ejemplo 2026 si aun no
# termina). Lo dejamos en el dato mensual y estacional (donde si hay
# informacion), pero lo excluimos del grafico anual (J-D) si esa
# columna quedo vacia, para no dibujar un "cero" o un hueco raro al
# final de la linea.
df_anual = df.dropna(subset=["J-D"]).copy()

# ------------------------------------------------------------------
# 2. Grafico 1: un mes elegido (enero) a lo largo del tiempo
# ------------------------------------------------------------------
mes_elegido = "Jan" 

fig, ax = plt.subplots(figsize=(9, 5))
ax.plot(df["Year"], df[mes_elegido], color="#1f77b4", linewidth=1.3)

# Linea de referencia en cero, con su etiqueta
ax.axhline(0, color="black", linewidth=0.8, linestyle="--")
ax.text(df["Year"].min(), 0.05, "promedio de 1951 a 1980", fontsize=9,
        va="bottom", ha="left")

ax.set_title("Anomalía de temperatura en enero - Hemisferio Norte (1880-"
             f"{int(df['Year'].max())})")
ax.set_xlabel("Año")
ax.set_ylabel("Anomalía de temperatura")
ax.spines["top"].set_visible(False)
ax.spines["right"].set_visible(False)
fig.tight_layout()
fig.savefig("../Figures/fig1_anomalia_mensual_enero.png", dpi=200)
plt.close(fig)
